# From backend/: Copy-Item .env.example .env
# Edit .env before starting PostgreSQL. Never commit the real .env file.

# Local PostgreSQL. The future Compose service will use the same credentials.
# Use a dedicated development database; never point tests at production data.
POSTGRES_DB=trading_lab
POSTGRES_USER=trading_lab
POSTGRES_PASSWORD=replace_with_a_local_password

# The CLI runs on the host. Compose will expose PostgreSQL on loopback only.
# Change the host port if another local PostgreSQL instance already uses 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Paths relative to backend/, regardless of the CLI working directory.
TRADING_LAB_REPORTS_DIR=reports
TRADING_LAB_LOG_LEVEL=INFO

# Data sync defaults, used only when the CLI does not specify a start time.
# This is a requested start, not a claim that exchange history is available.
TRADING_LAB_DATA_START=2021-01-01T00:00:00Z

# Bounded retries for transient exchange errors; rate limiting stays enabled.
# Retries are additional attempts after the initial request.
TRADING_LAB_FETCH_MAX_RETRIES=3
TRADING_LAB_FETCH_BACKOFF_SECONDS=1.0
TRADING_LAB_FETCH_TIMEOUT_MS=30000

# Public market data needs no Binance API key or secret.
# Market, symbol, timeframe, fees, slippage, leverage and funding policy belong
# in each explicit CLI request/backtest config and are preserved with the run.
